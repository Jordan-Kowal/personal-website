#!/bin/sh
set -eu

echo "---------- Git hook: pre-commit ----------"

# Biome (lint and format for .ts/.json)
echo ">>> [1/4] Running Biome"
bun biome:check

# Prettier (format for .svelte)
echo ">>> [2/4] Running Prettier"
bun prettier:check

# Typescript (type checking)
echo ">>> [3/4] Running svelte-check"
bun svelte:check

# Unit tests
echo ">>> [4/4] Running tests"
bun run test

echo "------------------------------------------"
