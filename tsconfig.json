{
  // Extends the config `svelte-kit sync` generates, so the module setup is not repeated here.
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    // Replaces the generated `paths` wholesale, so `$app/types` is restated. `@/*` mirrors
    // `resolve.alias` in vite.config.ts: Kit's `alias` option is deprecated, and subpath imports
    // (`#/*`) resolve neither extensionless files nor folder barrels.
    "paths": {
      "@/*": ["./src/*"],
      "$app/types": ["./.svelte-kit/types/index.d.ts"]
    },
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",

    // Type Checking & Safety
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "erasableSyntaxOnly": true,
    // bun:test needs its ambient types; the util tests live next to the code under src/.
    "types": ["@types/bun"]
  }
}
