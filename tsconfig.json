{
  // Extends the config `svelte-kit sync` generates, so the module setup is not repeated here.
  "extends": "$app/tsconfig",
  "include": ["src", "test", "*"],
  "exclude": ["src/service-worker"],
  "compilerOptions": {
    // `@/*` mirrors `resolve.alias` in vite.config.ts: Kit's `alias` option is deprecated, and
    // subpath imports (`#/*`) resolve neither extensionless files nor folder barrels.
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": false,
    // The generated config turns it on, and TypeScript rejects it without `allowJs`.
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",

    // Type Checking & Safety
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "erasableSyntaxOnly": true,
    // Replaces the generated `types` wholesale, so `$app/types` is restated. bun:test needs its
    // ambient types; the util tests live next to the code under src/.
    "types": ["$app/types", "@types/bun"]
  }
}
