{
  // Extends the config `svelte-kit sync` generates, so the module and path setup is not repeated
  // here. `@/*` comes from the `alias` option in vite.config.ts.
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",

    // Type Checking & Safety
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "erasableSyntaxOnly": true,
    // bun:test needs its ambient types; the util tests live next to the code under src/.
    "types": ["@types/bun"]
  }
}
