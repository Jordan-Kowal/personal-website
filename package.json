{
  "name": "personal-website",
  "version": "3.1.1",
  "type": "module",
  "private": true,
  "homepage": "/",
  "scripts": {
    "start": "vite",
    "build": "rimraf dist && vite build",
    "biome:check": "biome check ./src",
    "biome:check:fix": "biome check ./src --write --unsafe",
    "tsc": "tsc",
    "quality": "bun biome:check && bun tsc"
  },
  "dependencies": {
    "@solidjs/meta": "0.29.4",
    "dayjs": "1.11.21",
    "es-toolkit": "1.50.0",
    "lucide-solid": "1.26.0",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.1",
    "daisyui": "5.7.1",
    "postcss": "8.5.23",
    "rimraf": "6.1.3",
    "rollup-plugin-visualizer": "7.0.1",
    "solid-devtools": "0.34.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-solid": "2.11.13"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
