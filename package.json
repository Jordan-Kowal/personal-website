{
  "name": "personal-website",
  "version": "4.0.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "prepare": "svelte-kit sync || echo \"\"",
    "start": "vite dev",
    "build": "vite build && bun scripts/cspHash.ts",
    "preview": "vite preview",
    "biome:check": "biome check ./src ./scripts ./vite.config.ts",
    "biome:check:fix": "biome check ./src ./scripts ./vite.config.ts --write --unsafe",
    "prettier:check": "prettier --check .",
    "prettier:check:fix": "prettier --write .",
    "svelte:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "bun test src",
    "quality": "bun biome:check && bun prettier:check && bun svelte:check && bun run test"
  },
  "dependencies": {
    "@lucide/svelte": "1.46.0",
    "@threlte/core": "8.6.0",
    "@threlte/extras": "9.21.1",
    "dayjs": "1.11.21",
    "svelte": "5.57.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "@types/three": "0.186.0",
    "prettier": "3.9.7",
    "prettier-plugin-svelte": "4.1.1",
    "rollup-plugin-visualizer": "7.1.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
